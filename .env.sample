# Copy to .env (git ignores it) and fill in. Variables already set in the environment win.
# Everything here is commented out: uncomment a line to set it.

# Claude: prompt-to-part needs ONE of these three.
# 1. An Anthropic API key (https://platform.claude.com/settings/keys).
# ANTHROPIC_API_KEY=sk-ant-...
# 2. Or an OpenRouter key (https://openrouter.ai/settings/keys): Claude through OpenRouter's
#    Anthropic-compatible endpoint. The same key also powers AI artwork and product photos, so it is
#    worth setting next to an Anthropic key too (the Anthropic key then wins for Claude).
# OPENROUTER_API_KEY=sk-or-v1-...
# 3. Or any Anthropic-compatible provider: its token and address, with ANTHROPIC_API_KEY set but empty.
#    For OpenRouter this is https://openrouter.ai/api and your OpenRouter key as the token.
# ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_API_KEY=

# A password for every page and API call (the browser asks for it once; any user name). Off by
# default; set it whenever the app is reachable from other devices (PTP_BIND=0.0.0.0, PTP_HOST=0.0.0.0).
# PTP_PASSWORD=
# Most replies worked on at once, over all designs (default 4).
# PTP_MAX_GENERATIONS=4

# The model and reasoning effort the chat starts with (fable, opus, sonnet, haiku or a full model ID;
# low, medium, high, xhigh or max). Defaults: opus, high.
# PTP_MODEL=claude-opus-5-5
# PTP_EFFORT=high
# The OpenRouter image model for AI artwork and product photos, and the one used when it stays busy
# (rate-limited upstream; empty turns the fallback off).
# PTP_IMAGE_MODEL=google/gemini-3.1-flash-image
# PTP_IMAGE_FALLBACK=google/gemini-nano-banana-2.1

# The currency of the Cost tab and the price suggestion (an ISO code: USD, EUR, GBP, RON…; default USD),
# and where you sell, so the suggested price fits that market.
# PTP_CURRENCY=EUR
# PTP_COUNTRY=Germany

# Dictation (the microphone button): https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=sk_...
# Main language and other languages you may speak (ISO 639 codes, comma-separated, e.g. en and ro);
# without them ElevenLabs detects the language.
# ELEVENLABS_LANGUAGE=en
# ELEVENLABS_SECONDARY_LANGUAGES=ro

# Docker Compose only: the port the app is published on (on this computer only), 1 to build the image
# with Bambu Studio for the Cost tab and 3MF print settings, and 1 to build it with Blender for
# .blend export (docker compose up -d --build).
# PTP_PORT=8787
# Docker: the address it is published on; 0.0.0.0 makes the app reachable from your network (set
# PTP_PASSWORD too, and only on a network you trust).
# PTP_BIND=127.0.0.1
# The container's memory limit (Docker Compose only; default 8g).
# PTP_MEM_LIMIT=8g
# Names the app answers to besides localhost, comma-separated: this computer's address when reached from the network.
# PTP_HOSTS=192.168.1.20
# PTP_WITH_BAMBU=1
# Bambu Studio's "user" folder, for your own printer presets in the printer list (default: Bambu
# Studio's settings folder on this computer; in Docker, the mounted one, see docker-compose.yml).
# BAMBU_STUDIO_USER_DIR=/bambu-user
# PTP_WITH_BLENDER=1

# 3D figures (the picture menu's "3D figure" mode): Meshy makes a sculpted mesh from a description or
# a photo (https://www.meshy.ai/api; API keys need a Pro plan; 25 credits a model, 35 in colour).
# MESHY_API_KEY=msy_...
# Most Meshy models made in one reply (default 2; then it stops and asks you).
# PTP_MESHY_MAX_PER_REPLY=2
# Leave unset for Meshy itself. For the free local mock (`pnpm mock:meshy`), set both:
# MESHY_BASE_URL=http://127.0.0.1:8790/openapi
# MESHY_API_KEY=msy_mock
