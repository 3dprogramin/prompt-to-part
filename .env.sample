# Copy to .env (git ignores it) and fill in. Variables already set in the environment win.

# OpenRouter (https://openrouter.ai/settings/keys): one key for Claude (through OpenRouter's
# Anthropic-compatible endpoint) and for AI artwork (an image model draws people, characters, scenes).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or Claude straight from Anthropic (https://console.anthropic.com/settings/keys); this wins for
# Claude when both are set, and OpenRouter is then used for artwork only.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or, only for your own use on your own computer: your Claude subscription, through the account the
# claude CLI is logged in with or (in Docker, which has no login) a token from `claude setup-token`.
# Claude then never runs through OpenRouter or an API key.
# JIG_AUTH=subscription
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The main model and reasoning effort the chat starts with (opus, sonnet, haiku or a full model ID;
# low, medium, high, xhigh or max), and the image model for AI artwork.
JIG_MODEL=claude-opus-5-5
JIG_EFFORT=high
JIG_IMAGE_MODEL=google/gemini-3.1-flash-image
# Used when the image model stays busy (rate-limited upstream); empty turns it off.
JIG_IMAGE_FALLBACK=google/gemini-nano-banana-2.1

# Dictation (the microphone button): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Main language and other languages you may speak (ISO 639 codes, comma-separated);
# leave both empty to let ElevenLabs detect the language.
ELEVENLABS_LANGUAGE=en
ELEVENLABS_SECONDARY_LANGUAGES=ro

# Docker Compose only: the port Jig is published on (on this computer only), 1 to build the image
# with Bambu Studio for the Cost tab and 3MF print settings, and 1 to build it with Blender for
# .blend export (docker compose up -d --build).
# JIG_PORT=8787
# JIG_WITH_BAMBU=1
# JIG_WITH_BLENDER=1

# 3D figures (the picture menu's "3D figure" mode): Meshy makes a sculpted mesh from a description or
# a photo (https://www.meshy.ai/api; API keys need a Pro plan; 25 credits a model, 35 in colour).
# MESHY_API_KEY=msy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Most Meshy models Jig may make in one reply (default 2; then it stops and asks you).
# JIG_MESHY_MAX_PER_REPLY=2
# Leave unset for Meshy itself. For the free local mock (`npm run mock:meshy`), set both:
# MESHY_BASE_URL=http://127.0.0.1:8790/openapi
# MESHY_API_KEY=msy_mock
