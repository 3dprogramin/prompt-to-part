# Copy to .env (git ignores it) and fill in. Variables already set in the environment win.
# Everything here is commented out: uncomment a line to set it.

# Claude: Jig needs ONE of these three.
# 1. An Anthropic API key (https://platform.claude.com/settings/keys).
# ANTHROPIC_API_KEY=sk-ant-...
# 2. Or an OpenRouter key (https://openrouter.ai/settings/keys): Claude through OpenRouter's
#    Anthropic-compatible endpoint. The same key also powers AI artwork and product photos, so it is
#    worth setting next to an Anthropic key too (the Anthropic key then wins for Claude).
# OPENROUTER_API_KEY=sk-or-v1-...
# 3. Or, only for your own use on your own computer: your Claude subscription, through the account
#    the claude CLI is logged in with or (in Docker, which has no login) a token from
#    `claude setup-token`. Claude then never runs through OpenRouter or an API key.
# JIG_AUTH=subscription
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# The model and reasoning effort the chat starts with (opus, sonnet, haiku or a full model ID;
# low, medium, high, xhigh or max). Defaults: opus, high.
# JIG_MODEL=claude-opus-5-5
# JIG_EFFORT=high
# The OpenRouter image model for AI artwork and product photos, and the one used when it stays busy
# (rate-limited upstream; empty turns the fallback off).
# JIG_IMAGE_MODEL=google/gemini-3.1-flash-image
# JIG_IMAGE_FALLBACK=google/gemini-nano-banana-2.1

# Dictation (the microphone button): https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=sk_...
# Main language and other languages you may speak (ISO 639 codes, comma-separated, e.g. en and ro);
# without them ElevenLabs detects the language.
# ELEVENLABS_LANGUAGE=en
# ELEVENLABS_SECONDARY_LANGUAGES=ro

# Docker Compose only: the port Jig is published on (on this computer only), 1 to build the image
# with Bambu Studio for the Cost tab and 3MF print settings, and 1 to build it with Blender for
# .blend export (docker compose up -d --build).
# JIG_PORT=8787
# Docker: the address it is published on; 0.0.0.0 makes Jig reachable from your network (no login: trusted networks only).
# JIG_BIND=127.0.0.1
# Names Jig answers to besides localhost, comma-separated: this computer's address when reached from the network.
# JIG_HOSTS=192.168.1.20
# JIG_WITH_BAMBU=1
# JIG_WITH_BLENDER=1

# 3D figures (the picture menu's "3D figure" mode): Meshy makes a sculpted mesh from a description or
# a photo (https://www.meshy.ai/api; API keys need a Pro plan; 25 credits a model, 35 in colour).
# MESHY_API_KEY=msy_...
# Most Meshy models Jig may make in one reply (default 2; then it stops and asks you).
# JIG_MESHY_MAX_PER_REPLY=2
# Leave unset for Meshy itself. For the free local mock (`npm run mock:meshy`), set both:
# MESHY_BASE_URL=http://127.0.0.1:8790/openapi
# MESHY_API_KEY=msy_mock
