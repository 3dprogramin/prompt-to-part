# Copy to .env (git ignores it) and fill in. Variables already set in the environment win.

# Claude: an Anthropic API key (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or an Anthropic-compatible provider: its token and base URL, with ANTHROPIC_API_KEY set but empty.
# OpenRouter, for example:
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-v1-…
# ANTHROPIC_API_KEY=
# Or, only for your own use on your own computer: the Claude account the claude CLI is logged in with.
# JIG_AUTH=subscription

# Dictation (the microphone button): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Main language and other languages you may speak (ISO 639 codes, comma-separated);
# leave both empty to let ElevenLabs detect the language.
ELEVENLABS_LANGUAGE=en
ELEVENLABS_SECONDARY_LANGUAGES=ro
