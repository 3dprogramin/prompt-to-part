{
  "name": "jig",
  "version": "0.0.86",
  "private": true,
  "description": "AI-powered parametric CAD for 3D printing",
  "author": "3dprogramin <andrei@3dprogramin.io>",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "dev:watch": "concurrently -k -n server,web -c blue,green \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "rebuild": "scripts/rebuild.sh",
    "test:ui": "vite build && node --import tsx --test test/ui/smoke.ts",
    "mock:meshy": "tsx server/meshyMock.ts",
    "dev:litho": "vite -c litho/vite.config.ts",
    "build:litho": "vite build -c litho/vite.config.ts --mode lib && vite build -c litho/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@fontsource/allerta-stencil": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ses": "^2.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
